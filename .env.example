# Anthropic API key (can also be set from the Settings page in the app)
ANTHROPIC_API_KEY=

# Pinterest developer app (https://developers.pinterest.com/apps/)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Must match the redirect URI registered on your Pinterest app
PINTEREST_REDIRECT_URI=http://localhost:3001/api/pinterest/callback

PORT=3001
